# WooCommerce headless storefront. Set to the WordPress/WooCommerce site root, without a trailing slash.
# Public Store API only; never put WooCommerce consumer secrets in VITE_* variables.
VITE_WOOCOMMERCE_URL=
VITE_CURRENCY=EUR
VITE_WOOCOMMERCE_SHOP_PATH=/shop/
VITE_WOOCOMMERCE_CART_PATH=/cart/
VITE_WOOCOMMERCE_CHECKOUT_PATH=/checkout/

# Public storefront configuration (non-secret values only)
SITE_URL=http://localhost:5173
STORE_NAME=Davinova
OWNER_EMAIL=owner@example.com
CURRENCY=USD

# Admin / owner approval
ADMIN_PASSWORD=replace-with-long-random-password
APPROVAL_SECRET=replace-with-at-least-32-random-bytes

# CJ Dropshipping primary fulfilment provider. Keep these safe defaults until verified.
CJ_API_KEY=
CJ_TOKEN_ENCRYPTION_KEY=
CJ_LOGISTIC_NAME=
CJ_FROM_COUNTRY_CODE=CN
CJ_SANDBOX=true
CJ_LIVE_ORDERS_ENABLED=false

# Stripe — test mode only until checkout + webhook signature verification is complete.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Explicit fulfilment destinations and customer delivery fee; set these only after confirming your policies.
STRIPE_SHIPPING_COUNTRIES=
STRIPE_SHIPPING_FEE_CENTS=
STRIPE_SHIPPING_LABEL=Standard delivery
STRIPE_AUTOMATIC_TAX=false

# PayPal — sandbox only until capture + webhook verification is complete.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Email — configure a verified sender/domain before sending transactional emails.
RESEND_API_KEY=
EMAIL_FROM=Davinova <orders@example.com>

# Optional analytics only after consent is implemented.
GA4_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=

# Fail-safe supplier purchase guard; true means no CJ API order requests are made.
DRY_RUN=true
