# Public storefront settings
SITE_URL=http://localhost:5173
STORE_NAME=Davinova
OWNER_EMAIL=owner@example.com
CURRENCY=USD

# Admin / approval — use long random values in deployment secrets
ADMIN_PASSWORD=replace-with-long-random-password
APPROVAL_SECRET=replace-with-at-least-32-random-bytes

# Stripe — test mode only until webhooks are verified
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal — use sandbox credentials first
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# FondMart — product-data import and order forwarding are not yet configured.
# Confirm the supported custom-store integration method in your FondMart account before adding credentials.

# Email
RESEND_API_KEY=
EMAIL_FROM=Davinova <orders@example.com>

# Optional analytics, only load after consent
GA4_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=

# Safety switches
DRY_RUN=true
